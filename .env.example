# WhatsApp MCP Server Configuration

# Directory to store Baileys auth session credentials
WHATSAPP_AUTH_DIR=./auth_state

# Directory to store daily digest files
WHATSAPP_DIGEST_DIR=./digests

# Cron schedule for daily digest (default: 8:00 AM every day)
WHATSAPP_DIGEST_CRON=0 8 * * *

# Log level: silent, fatal, error, warn, info, debug, trace
LOG_LEVEL=warn
